# Falla la instalacion si Node/npm no cumplen el campo "engines" de package.json,
# en vez de avisar y seguir de largo.
engine-strict=true

# No ejecutar los scripts de ciclo de vida (preinstall/install/postinstall) de las
# dependencias: son la principal via de ataque de supply chain en npm. Hoy ninguna
# dependencia del proyecto los necesita (la unica que los declara es core-js, y solo
# imprime un mensaje pidiendo fondeo).
# Si en el futuro alguna dependencia necesita compilar binarios, correr una vez:
#   npm install --ignore-scripts=false --foreground-scripts
ignore-scripts=true

# `npm audit` (y `npm run audit`) falla solo ante vulnerabilidades altas o criticas.
audit-level=high

# Menos ruido en la salida de npm.
fund=false
